<mujoco model="go2 rough hfield track">
  <compiler angle="radian" meshdir="../../../reference_repos/unitree_mujoco/unitree_robots/go2/assets" autolimits="true" />
  <include file="../../../reference_repos/unitree_mujoco/unitree_robots/go2/go2.xml" />

  <statistic center="6.0 0 0.20" extent="2.4" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2" />
    <hfield
      name="perlin_hfield"
      size="1.25 0.9 0.08 0.2"
      file="../../../reference_repos/unitree_mujoco/unitree_robots/go2/height_field.png" />
    <hfield
      name="image_hfield"
      size="1.25 0.9 0.02 0.1"
      file="../../../reference_repos/unitree_mujoco/unitree_robots/go2/unitree_hfield.png" />
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- Low guide curbs keep the robot on the intended traversable strip
         without turning the test into a narrow staircase corridor. -->
    <geom pos="5.80 1.02 0.035" type="box" size="5.90 0.05 0.035" />
    <geom pos="5.80 -1.02 0.035" type="box" size="5.90 0.05 0.035" />

    <!-- Entry pads and shallow stitched ramps keep contact continuous before
         entering the rough sections. -->
    <geom pos="1.00 0.00 0.012" type="box" size="0.40 0.92 0.012" />
    <geom pos="1.55 0.00 0.025" type="box" size="0.30 0.92 0.013" />
    <geom pos="2.00 0.00 0.038" type="box" size="0.22 0.92 0.013" />

    <!-- Continuous stitched rough track built from alternating heightfield
         patches. This is still static, but it is much closer to the broad
         contact-rich roughness family than the old handcrafted corridor. -->
    <geom type="hfield" hfield="image_hfield" pos="3.25 0.0 0.0" quat="1 0 0 0" />
    <geom type="hfield" hfield="perlin_hfield" pos="5.65 0.0 0.0" quat="1 0 0 0" />
    <geom type="hfield" hfield="image_hfield" pos="8.05 0.0 0.0" quat="0 0 0 1" />
    <geom type="hfield" hfield="perlin_hfield" pos="10.45 0.0 0.0" quat="0 0 0 1" />

    <!-- Seam-bridging rough slabs between hfield sections. -->
    <geom pos="4.45 0.00 0.018" type="box" size="0.15 0.90 0.018" />
    <geom pos="6.85 0.00 0.022" type="box" size="0.15 0.90 0.022" />
    <geom pos="9.25 0.00 0.020" type="box" size="0.15 0.90 0.020" />

    <!-- Mild off-axis finish to preserve continuous command-tracking pressure. -->
    <geom pos="11.80 0.00 0.020" type="box" size="0.30 0.90 0.020" />
    <geom pos="12.30 0.12 0.035" type="box" size="0.18 0.28 0.035" quat="0.9990482 0 0 -0.0436194" />
    <geom pos="12.75 -0.10 0.045" type="box" size="0.18 0.24 0.045" quat="0.9990482 0 0 0.0436194" />
  </worldbody>
</mujoco>
